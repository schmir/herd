# The commits every build is pinned to. tools/gen-ninja.py reads this file,
# just loads it into the environment of the recipes, and the Nix devshell
# sources it. Keep to plain KEY=value lines: no quotes, no export, no spaces.
# To update a pin, change it here; the next build fetches it.

# Janet 1.41.2, which the release binaries are cross-compiled from. The build
# also compiles it for the host, as build/janet, which makes the image.
JANET_COMMIT=0fea20c82182fe661f75b00a8889d801fe2d79b6

# spork, which the build checks out into deps/spork and the release binaries
# link in.
SPORK_COMMIT=26af769b7fd8f7214ea8f95dad5c2d360a79f6b4
