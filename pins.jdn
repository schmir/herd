 :janet "0fea20c82182fe661f75b00a8889d801fe2d79b6"
 # spork, which the build checks out into deps/spork and the release
 # binaries link in.
 :spork "26af769b7fd8f7214ea8f95dad5c2d360a79f6b4"}
